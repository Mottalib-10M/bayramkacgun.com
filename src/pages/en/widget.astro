---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'bayram-geri-sayim', h2: 'Bayram countdown', text: 'A live countdown to the next feast, Ramadan, Laylat al-Qadr or public holiday, with the dates from the Diyanet list.', t: 'Bayram countdown, Turkey', h: 620 },
  { name: 'imsakiye', h2: 'Ramadan timetable for 81 provinces', text: 'Imsak and iftar day by day for any province, Ramadan 2027 and 2028, computed with Diyanet parameters.', t: 'Ramadan timetable, Turkey', h: 980 },
];
---
<PageLayout title="Embed the bayram countdown and Ramadan timetable for free" description="Embed the Turkish bayram countdown and the 81-province Ramadan timetable for free with an iframe: copy the code once, and new years appear on your site by themselves." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the bayram countdown</h1>
    <p class="mt-3 text-lg text-navy-700">For websites, newsrooms and HR teams: copy once, new years appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the Turkish version, replace <code>/embed/en/</code> with <code>/embed/tr/</code>. Terms: the source link under the tool stays visible, the tool is not altered and is provided without warranty. What your readers choose stays on their device. Questions through the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/bayram-geri-sayim/`} title="Bayram countdown, Turkey" width="100%" height="620" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
