---
/** Chaque page de sujet (src/content/guides), version tr. */
import ContentPage from '../../components/ContentPage.astro';
import { GUIDES } from '../../lib/pages';
import type { GuideDef } from '../../lib/page-types';
export function getStaticPaths() {
  return GUIDES.filter((page) => page.tr).map((page) => ({ params: { slug: page.tr!.slug }, props: { page } }));
}
const { page } = Astro.props as { page: GuideDef };
---
<ContentPage page={page} lang="tr" />
