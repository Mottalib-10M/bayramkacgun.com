---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'tr';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'bayram-geri-sayim', h2: 'Bayram geri sayımı', text: 'Bir sonraki bayrama, Ramazana, Kadir Gecesine ya da resmi tatile canlı geri sayım; tarihler Diyanet listesinden.', t: 'Bayram geri sayımı', h: 620 },
  { name: 'imsakiye', h2: '81 il için imsakiye', text: 'Her il için gün gün imsak ve iftar, Ramazan 2027 ve 2028; Diyanet ölçüleriyle hesaplanır.', t: 'İmsakiye, 81 il', h: 980 },
];
---
<PageLayout title="Bayram sayacını ve imsakiyeyi sitenize ücretsiz ekleyin" description="Bayram geri sayımını ve 81 il için imsakiyeyi bir iframe ile sitenize ücretsiz ekleyin: kodu bir kez kopyalayın, yeni yıllar sitenizde kendiliğinden görünür." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Ana sayfa', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Bayram sayacını sitenize ekleyin</h1>
    <p class="mt-3 text-lg text-navy-700">Siteler, haber odaları ve insan kaynakları ekipleri için: bir kez kopyalayın, yeni yıllar kendiliğinden gelir.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>İngilizce sürüm için <code>/embed/tr/</code> yerine <code>/embed/en/</code> yazın. Koşullar: aracın altındaki kaynak bağlantısı görünür kalır, araç değiştirilmez ve garanti verilmeden sunulur. Okurlarınızın seçtikleri kendi cihazlarında kalır. Sorular için <a href={route('contact', lang)}>iletişim sayfası</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/bayram-geri-sayim/`} title="Bayram geri sayımı" width="100%" height="620" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
