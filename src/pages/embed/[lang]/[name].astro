---
/** Pages à intégrer (iframe) : un outil seul, en turc et en anglais. noindex, hors sitemap (astro.config). */
import '../../../styles/global.css';
import Tool from '../../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route, hasRoute } from '../../../i18n/routes';
import type { Lang } from '../../../lib/format';
const EMBEDS = {
  'bayram-geri-sayim': { kind: 'geri', arg: undefined, page: 'bayrama-kac-gun-kaldi', t: { tr: 'Bayrama kaç gün kaldı', en: 'Countdown to the next bayram in Turkey' } },
  'imsakiye': { kind: 'im', arg: undefined, page: 'imsakiye-2027', t: { tr: 'İmsakiye: 81 il', en: 'Ramadan timetable for 81 Turkish provinces' } },
} as const;
export function getStaticPaths() {
  return (['tr', 'en'] as const).flatMap((lang) => ['bayram-geri-sayim', 'imsakiye'].map((name) => ({ params: { lang, name } })));
}
const { lang, name } = Astro.params as { lang: Lang; name: keyof typeof EMBEDS };
const e = EMBEDS[name];
const page = `${SITE_URL}${route(hasRoute(e.page, lang) ? e.page : 'home', lang)}`;
const note = { tr: 'Girdiğiniz bilgiler cihazınızda kalır · araç Radif Partners tarafından hazırlanmıştır, resmi bir hizmet değildir', en: 'What you enter stays on your device · tool by Radif Partners, not a government service' }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${e.t[lang]} (${lang === 'tr' ? 'sitenize ekleyin' : 'embed'})`}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind={e.kind} lang={lang} arg={e.arg} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {note}</p>
  </body>
</html>
